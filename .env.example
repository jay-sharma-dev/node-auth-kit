AUTH_ACCESS_SECRET=replace_with_a_random_secret_of_32_bytes_or_more
AUTH_ACCESS_EXPIRES_SECONDS=900
AUTH_BCRYPT_ROUNDS=12
AUTH_ISSUER=jay-auth-kit
AUTH_AUDIENCE=my-api

# OTP / password reset (optional — pepper falls back to AUTH_ACCESS_SECRET)
AUTH_OTP_PEPPER=replace_with_another_random_secret_of_32_bytes_or_more
AUTH_OTP_LENGTH=6
AUTH_OTP_EXPIRES_SECONDS=600
AUTH_OTP_MAX_ATTEMPTS=5
